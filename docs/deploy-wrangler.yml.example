# ALTERNATYWA dla integracji Git w panelu Cloudflare – wdrożenie z GitHub Actions.
# Użyj tylko, jeśli NIE podłączasz repozytorium w panelu Cloudflare (inaczej wdroży się dwa razy).
# 1) Skopiuj ten plik do .github/workflows/deploy.yml
# 2) W GitHub → Settings → Secrets and variables → Actions dodaj:
#    CLOUDFLARE_API_TOKEN (uprawnienie: Cloudflare Pages – Edit) i CLOUDFLARE_ACCOUNT_ID
name: Deploy HISTADA
on:
  push:
    branches: [main]
jobs:
  deploy:
    runs-on: ubuntu-latest
    permissions: { contents: read, deployments: write }
    steps:
      - uses: actions/checkout@v4
      - uses: cloudflare/wrangler-action@v3
        with:
          apiToken: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          accountId: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
          command: pages deploy public --project-name=histada
